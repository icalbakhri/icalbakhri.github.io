---
layout: null
---
[
  {% for post in site.posts %}
    {
      "title": "{{ post.title | escape }}",
      "url": "{{ site.baseurl }}{{ post.url }}",
      "date": "{{ post.date | date: '%d %b %Y' }}",
      "tags": "{{ post.tags | join: ', ' }}"
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
]